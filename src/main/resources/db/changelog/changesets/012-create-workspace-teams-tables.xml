<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="012-create-workspace-teams-tables" author="chronelis">
        <createTable tableName="workspace_teams">
            <column name="id" type="BIGINT UNSIGNED" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="workspace_id" type="BIGINT UNSIGNED">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(150)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="TEXT">
                <constraints nullable="true"/>
            </column>
            <column name="created_by" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="DATETIME(6)">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="DATETIME(6)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint tableName="workspace_teams" columnNames="workspace_id, name" constraintName="uq_workspace_teams_workspace_name"/>

        <addForeignKeyConstraint baseTableName="workspace_teams" baseColumnNames="workspace_id" referencedTableName="workspaces" referencedColumnNames="id" constraintName="fk_workspace_teams_workspace" onDelete="CASCADE"/>

        <addForeignKeyConstraint baseTableName="workspace_teams" baseColumnNames="created_by" referencedTableName="users" referencedColumnNames="user_id" constraintName="fk_workspace_teams_created_by" onDelete="RESTRICT"/>

        <createIndex tableName="workspace_teams" indexName="idx_workspace_teams_workspace_id">
            <column name="workspace_id"/>
        </createIndex>

        <!-- workspace_team_members -->
        <createTable tableName="workspace_team_members">
            <column name="id" type="BIGINT UNSIGNED" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="team_id" type="BIGINT UNSIGNED">
                <constraints nullable="false"/>
            </column>
            <column name="user_id" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="joined_at" type="DATETIME(6)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint tableName="workspace_team_members" columnNames="team_id, user_id" constraintName="uq_workspace_team_members_team_user"/>

        <addForeignKeyConstraint baseTableName="workspace_team_members" baseColumnNames="team_id" referencedTableName="workspace_teams" referencedColumnNames="id" constraintName="fk_team_members_team" onDelete="CASCADE"/>

        <addForeignKeyConstraint baseTableName="workspace_team_members" baseColumnNames="user_id" referencedTableName="users" referencedColumnNames="user_id" constraintName="fk_team_members_user" onDelete="CASCADE"/>
    </changeSet>

</databaseChangeLog>
