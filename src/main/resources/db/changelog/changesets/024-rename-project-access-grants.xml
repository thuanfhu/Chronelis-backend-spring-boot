<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="024-rename-project-access-grants" author="chronelis">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="project_accesses"/>
            <not>
                <tableExists tableName="project_access_grants"/>
            </not>
        </preConditions>

        <renameTable oldTableName="project_accesses" newTableName="project_access_grants"/>
    </changeSet>

</databaseChangeLog>
