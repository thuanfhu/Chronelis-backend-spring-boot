<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="009-1" author="chronelis">
        <comment>Add description column to projects table</comment>
        <addColumn tableName="projects">
            <column name="description" type="TEXT" />
        </addColumn>
    </changeSet>

    <changeSet id="009-2" author="chronelis">
        <comment>Add description column to tasks table</comment>
        <addColumn tableName="tasks">
            <column name="description" type="TEXT" />
        </addColumn>
    </changeSet>

</databaseChangeLog>
