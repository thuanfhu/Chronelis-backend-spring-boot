<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="026-add-pomodoro-session-time-range" author="devloopsx">
        <addColumn tableName="pomodoro_sessions">
            <column name="started_at" type="DATETIME"/>
            <column name="ended_at" type="DATETIME"/>
        </addColumn>

        <createIndex tableName="pomodoro_sessions" indexName="idx_pomodoro_sessions_task_user_ended">
            <column name="task_id"/>
            <column name="user_id"/>
            <column name="ended_at"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
