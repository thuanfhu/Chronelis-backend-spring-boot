<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="019-add-task-last-open-status" author="chronelis">
        <addColumn tableName="tasks">
            <column name="last_open_status_id" type="BIGINT UNSIGNED">
                <constraints nullable="true"/>
            </column>
        </addColumn>

        <addForeignKeyConstraint baseTableName="tasks" baseColumnNames="last_open_status_id" referencedTableName="task_statuses" referencedColumnNames="id" constraintName="fk_tasks_last_open_status" onDelete="SET NULL"/>

        <createIndex tableName="tasks" indexName="idx_tasks_last_open_status_id">
            <column name="last_open_status_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
