<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="013-create-workspace-invites-table" author="chronelis">
        <createTable tableName="workspace_invites">
            <column name="id" type="BIGINT UNSIGNED" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="workspace_id" type="BIGINT UNSIGNED">
                <constraints nullable="false"/>
            </column>
            <column name="invite_code" type="VARCHAR(20)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uq_workspace_invites_code"/>
            </column>
            <column name="role_to_assign" type="VARCHAR(30)" defaultValue="MEMBER">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="max_uses" type="INT">
                <constraints nullable="true"/>
            </column>
            <column name="used_count" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="expires_at" type="DATETIME(6)">
                <constraints nullable="true"/>
            </column>
            <column name="is_active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="DATETIME(6)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint baseTableName="workspace_invites" baseColumnNames="workspace_id" referencedTableName="workspaces" referencedColumnNames="id" constraintName="fk_workspace_invites_workspace" onDelete="CASCADE"/>

        <addForeignKeyConstraint baseTableName="workspace_invites" baseColumnNames="created_by" referencedTableName="users" referencedColumnNames="user_id" constraintName="fk_workspace_invites_created_by" onDelete="RESTRICT"/>

        <createIndex tableName="workspace_invites" indexName="idx_workspace_invites_workspace_id">
            <column name="workspace_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
