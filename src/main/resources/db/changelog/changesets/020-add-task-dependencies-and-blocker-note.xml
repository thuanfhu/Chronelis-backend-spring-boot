<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="020-add-task-dependencies-and-blocker-note" author="chronelis">
        <addColumn tableName="tasks">
            <column name="blocker_note" type="MEDIUMTEXT" />
        </addColumn>

        <createTable tableName="task_dependencies">
            <column name="id" type="BIGINT UNSIGNED" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="task_id" type="BIGINT UNSIGNED">
                <constraints nullable="false"/>
            </column>
            <column name="depends_on_task_id" type="BIGINT UNSIGNED">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP(6)" defaultValueComputed="CURRENT_TIMESTAMP(6)">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP(6)" defaultValueComputed="CURRENT_TIMESTAMP(6)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint tableName="task_dependencies" columnNames="task_id,depends_on_task_id" constraintName="uk_task_dependencies_task_depends_on"/>

        <addForeignKeyConstraint baseTableName="task_dependencies" baseColumnNames="task_id" referencedTableName="tasks" referencedColumnNames="id" constraintName="fk_task_dependencies_task" onDelete="CASCADE"/>
        <addForeignKeyConstraint baseTableName="task_dependencies" baseColumnNames="depends_on_task_id" referencedTableName="tasks" referencedColumnNames="id" constraintName="fk_task_dependencies_depends_on_task" onDelete="CASCADE"/>
        <addForeignKeyConstraint baseTableName="task_dependencies" baseColumnNames="created_by" referencedTableName="users" referencedColumnNames="user_id" constraintName="fk_task_dependencies_created_by" onDelete="RESTRICT"/>

        <createIndex tableName="task_dependencies" indexName="idx_task_dependencies_task_id">
            <column name="task_id"/>
        </createIndex>

        <createIndex tableName="task_dependencies" indexName="idx_task_dependencies_depends_on_task_id">
            <column name="depends_on_task_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>