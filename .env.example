# Chronelis
FRONTEND_BASE_URL=https://www.chronelis.io.vn
ACCOUNT_BASE_PASSWORD=Chronelis123@
ALLOWED_INIT=true

# Seed configuration: keep disabled by default (no demo seeding)
CHRONELIS_SEED_ENABLED=false
CHRONELIS_SEED_RESET_COLLABORATION_DATA=false

# Port
SERVER_PORT=8080

# MySQL
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# Mail
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# JWT
JWT_ACCESS_SIGNER_KEY=
JWT_REFRESH_SIGNER_KEY=
JWT_ACCESS_TOKEN_DURATION=
JWT_REFRESH_TOKEN_DURATION=

# Azure Storage
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONTAINER_NAME=
AZURE_STORAGE_ENDPOINT=

# Redis - Local Docker Redis (plain TCP)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_SSL=false
REDIS_TIMEOUT=1000
REDIS_CACHE_MAX_PAYLOAD_BYTES=65536
REDIS_POOL_MAX_ACTIVE=
REDIS_POOL_MAX_IDLE=
REDIS_POOL_MIN_IDLE=
REDIS_POOL_MAX_WAIT=

# Redis Cloud example (copy to .env and fill real values, do not commit secrets)
# REDIS_HOST=your-redis-cloud-host
# REDIS_PORT=your-redis-cloud-port
# REDIS_USERNAME=default
# REDIS_PASSWORD=your-redis-password
# REDIS_SSL=true
# REDIS_TIMEOUT=2000
# REDIS_CACHE_MAX_PAYLOAD_BYTES=65536

# File upload config
FILE_ALLOWED_TYPES=image/jpeg,image/png,image/jpg,audio/mpeg
FILE_MAX_SIZE=5242880
FILE_MIN_SIZE=1024
